# ---------------------------------------------------------------------------
# This repo's root IS the Windows home directory (C:\Users\mtamp), so git would
# otherwise crawl the entire user profile. Everything below keeps `git status`
# scoped to actual project files.
# ---------------------------------------------------------------------------

# Credentials / shell state
.gitconfig
.lesshst
.bash_history
.python_history
*.pem
*.key
credentials.json
token.json

# Windows user-profile folders
AppData/
Contacts/
Desktop/
Downloads/
Favorites/
Links/
Music/
Pictures/
Videos/
Searches/
OneDrive/
Saved Games/
"Saved Games"/

# Windows junctions (these are what throw "Permission denied" on git status)
Application Data/
Cookies/
Local Settings/
My Documents/
NetHood/
PrintHood/
Recent/
SendTo/
Start Menu/
Templates/
Documents/My Music/
Documents/My Pictures/
Documents/My Videos/

# Windows registry / system files
NTUSER.DAT*
ntuser.dat*
ntuser.ini
*.regtrans-ms
*.blf
*.cnpf

# Tool + library caches
.config/
.local/
.matplotlib/
.pybaseball/
.ipython/
.jupyter/
.cache/
.npm/
node_modules/

# Everything under Documents/ except the Fantasy Baseball work
Documents/*
!Documents/Fantasy Baseball/

# Nested git repos (they have their own .git and their own remotes)
Documents/Fantasy Baseball/HR Picks/
Documents/Fantasy Baseball/fantasybaseball/
